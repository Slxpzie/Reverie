"<!DOCTYPE html>\n<html lang=\"en\"><head>\n<meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"theme-color\" content=\"#ffffff\">\n<title>Reverie — Collection<\/title><meta name=\"description\" content=\"Explore the Reverie clothing collection.\">\n<!-- REVERIE / FINAL WHITE EDITION\nWix: paste this entire file into an Embed HTML element, not Dashboard Custom Code.\nSet the embed to full available width and a suitable viewport height.\nAll 12 product images from the supplied ZIP and the existing logo are embedded.\nProduct images use the supplied PNG bytes without modification. SVG viewBoxes frame the\nproducts without changing or cropping the source images. No image hosting needed.\nThe opening logo holds for 850ms, then moves into the header over 1150ms.\nClick the intro or press Escape to skip it. Reduced motion skips the intro.\nRight half = next product; left half = previous. Arrow keys and swipes supported.\nBlack butterflies and whole-slide transitions remain. The background stays white.\nTo rename a product, edit its data-name and caption. Order follows filenames.\n-->\n<style>:root{color-scheme:light;--ink:#111;--muted:#757575;--brand-font:'Times New Roman',Times,serif}\n*{box-sizing:border-box}[hidden]{display:none!important}html,body{margin:0;width:100%;height:100%;background:#fff;color:var(--ink)}body{overflow:hidden;font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}button{font:inherit;color:inherit;border:0;background:none;padding:0;cursor:pointer;-webkit-tap-highlight-color:transparent}button:focus-visible{outline:1px solid #888;outline-offset:-10px}::selection{background:#111;color:#fff}\n.gallery{height:100vh;height:100svh;min-height:340px;display:grid;grid-template-rows:98px minmax(0,1fr) 54px;background:white;isolation:isolate;overflow:hidden;position:relative}\n.header{display:flex;align-items:center;justify-content:center;position:relative;z-index:5;background:#fff}.header:after{content:'';position:absolute;bottom:0;left:5%;right:5%;height:1px;background:#eee;opacity:1;transition:opacity .9s ease}.brand{display:flex;align-items:center;gap:17px}.brand-symbol{display:block;width:68px;height:55px;flex:none}.wordmark{font:700 43px/1 var(--brand-font);letter-spacing:-1.8px;transition:opacity .85s ease,transform .85s cubic-bezier(.2,.7,.2,1)}\n.stage{position:relative;min-height:0;perspective:1500px;overflow:hidden;touch-action:pan-y;transition:opacity 1s ease,transform 1s cubic-bezier(.2,.7,.2,1)}.slide{position:absolute;inset:0;display:grid;grid-template-rows:minmax(0,1fr) auto;justify-items:center;padding:12px 3vw 0;opacity:0;visibility:hidden;pointer-events:none;transform-origin:50% 45%}.slide.active{opacity:1;visibility:visible}.slide.transitioning{visibility:visible;will-change:transform,opacity,filter}.product-art{width:min(1260px,94vw);height:100%;min-height:0;display:grid;place-items:center}.product-art svg{display:block;width:100%;height:100%;overflow:hidden}.caption{text-align:center;padding:17px 0 3px}.caption h1,.caption h2{font:400 clamp(20px,2.1vw,29px)/1.15 var(--brand-font);letter-spacing:-.65px;margin:0}.caption p{font-size:8px;line-height:1.5;letter-spacing:1.8px;text-transform:uppercase;color:var(--muted);margin:8px 0 0}\n.side{position:absolute;inset:0 auto 0 0;width:50%;z-index:8;touch-action:pan-y}.side.next{left:50%}.side[aria-disabled=true]{cursor:default}.product-counter{display:flex;align-items:center;justify-content:center;gap:13px;font-size:10px;letter-spacing:2px;font-variant-numeric:tabular-nums;color:#969696;padding-bottom:5px;transition:opacity .8s ease}.product-counter strong{font-weight:400;color:#111}.product-counter .slash{color:#bcbcbc}.butterflies{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:9}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);clip-path:inset(50%);white-space:nowrap}\n.intro{position:fixed;inset:0;z-index:100;cursor:pointer}.intro-veil{position:absolute;inset:0;background:#fff}.intro-logo{position:absolute;left:50%;top:50%;width:clamp(170px,20vw,250px);aspect-ratio:555/442;transform:translate(-50%,-50%);transform-origin:center;will-change:transform,opacity}.intro-logo svg{display:block;width:100%;height:100%}.intro-pending .header .brand-symbol{opacity:0}.intro-pending:not(.revealing) .wordmark{opacity:0;transform:translateY(7px)}.intro-pending:not(.revealing) .header:after{opacity:0}.intro-pending:not(.revealing) .stage{opacity:0;transform:translateY(22px) scale(.98)}.intro-pending:not(.revealing) .product-counter{opacity:0}\n@media(max-width:640px){.gallery{grid-template-rows:82px minmax(0,1fr) 48px}.brand{gap:12px}.brand-symbol{width:52px;height:42px}.wordmark{font-size:34px;letter-spacing:-1.4px}.slide{padding:8px 8px 0}.product-art{width:calc(100vw - 16px)}.caption{padding:18px 12px 5px}.caption h1,.caption h2{font-size:23px}.caption p{font-size:8px}.product-counter{padding-bottom:9px}.intro-logo{width:190px}}\n@media(max-height:540px) and (min-width:641px){.gallery{grid-template-rows:62px minmax(0,1fr) 35px}.brand-symbol{width:40px;height:32px}.wordmark{font-size:29px}.slide{padding-top:4px}.caption{padding-top:6px}.caption h1,.caption h2{font-size:19px}.caption p{margin-top:3px}.product-counter{padding:0}}\n@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}.butterflies{display:none}}\n<\/style>\n<style data-knitwear-style>body.knit-collection .gallery{grid-template-rows:98px minmax(0,1fr) auto 44px}\nbody.knit-collection .caption{display:none}\nbody.knit-collection .slide{grid-template-rows:minmax(0,1fr);padding-top:0}\nbody.knit-collection .product-art{width:min(1440px,96vw)}\n.knit-art{position:relative;width:100%;height:100%;min-height:0;isolation:isolate}\n.knit-colour-layer{position:absolute;inset:0;background:#fff;overflow:hidden;pointer-events:none}\n.knit-colour-layer svg{display:block;width:100%;height:100%}\n.knit-controls{position:relative;z-index:12;display:flex;flex-direction:column;align-items:center;gap:5px;background:#fff;padding:4px 12px 8px}\n.knit-designs{display:flex;align-items:center;gap:30px;margin-bottom:5px}\n.knit-designs button{min-height:40px;padding:5px 0;font:400 17px/1.2 'Times New Roman',serif;color:#777;transition:color .2s}\n.knit-designs button[aria-pressed=true]{color:#111;text-decoration:underline;text-underline-offset:7px;text-decoration-thickness:1px}\n.knit-colors{display:flex;align-items:center;justify-content:center;gap:2px}\n.knit-swatch{width:42px;height:42px;display:grid;place-items:center;touch-action:manipulation}\n.knit-swatch span{display:block;width:19px;height:19px;border-radius:50%;background:var(--swatch);position:relative}\n.knit-swatch span:after{content:'';position:absolute;inset:-4px;border:1px solid #333;border-radius:50%;opacity:0;transform:scale(.8);transition:opacity .24s ease,transform .24s ease}\n.knit-swatch[aria-pressed=true] span:after{opacity:1;transform:scale(1)}\n.knit-controls button:focus-visible{outline:1px solid #777;outline-offset:1px}\n.knit-controls button:disabled{cursor:default}\n.knit-color-name{font:400 10px/1.2 Arial,sans-serif;color:#666;letter-spacing:.7px;min-height:13px}\n@media(max-width:640px){body.knit-collection .gallery{grid-template-rows:82px minmax(0,1fr) auto 38px}.knit-designs{gap:25px}.knit-designs button{font-size:16px}.knit-controls{padding-bottom:4px}.knit-swatch{width:44px;height:42px}body.knit-collection .product-art{width:calc(100vw - 16px)}}\n@media(max-height:540px) and (min-width:641px){body.knit-collection .gallery{grid-template-rows:62px minmax(0,1fr) auto 28px}.knit-controls{flex-direction:row;justify-content:center;gap:20px;padding:0 10px}.knit-designs{margin:0}.knit-color-name{min-width:52px}}\n@media(prefers-reduced-motion:reduce){.knit-controls *{transition:none!important}}\n<\/style><\/head><body class=\"intro-pending\">\n<svg width=\"0\" height=\"0\" aria-hidden=