s=\"product-art\"><svg viewBox=\"364 199 1197 636\" role=\"img\" aria-label=\"Blue Butterfly Hoodie — Front &amp; back\"><image href=\"data:image/png;base64,\" width=\"1920\" height=\"1080\"/><\/svg><\/div>\n<div class=\"caption\"><h2>Blue Butterfly Hoodie<\/h2><p>Front &amp; back<\/p><\/div><\/section><section class=\"slide\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"11 of 12\" aria-hidden=\"true\" data-name=\"Tonal Butterfly Hoodie\" data-source=\"12.png\" inert>\n<div class=\"product-art\"><svg viewBox=\"301 199 1395 613\" role=\"img\" aria-label=\"Tonal Butterfly Hoodie — Front &amp; back\"><image href=\"data:image/png;base64,\" width=\"1920\" height=\"1080\"/><\/svg><\/div>\n<div class=\"caption\"><h2>Tonal Butterfly Hoodie<\/h2><p>Front &amp; back<\/p><\/div><\/section><section class=\"slide\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"12 of 12\" aria-hidden=\"true\" data-name=\"Signature Hoodie\" data-source=\"13.png\" inert>\n<div class=\"product-art\"><svg viewBox=\"324 161 1272 649\" role=\"img\" aria-label=\"Signature Hoodie — Front &amp; back\"><image href=\"data:image/png;base64,\" width=\"1920\" height=\"1080\"/><\/svg><\/div>\n<div class=\"caption\"><h2>Signature Hoodie<\/h2><p>Front &amp; back<\/p><\/div><\/section><section class=\"slide\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"13 of 14\" aria-hidden=\"true\" data-name=\"Butterfly Knitwear\" data-source=\"knit-butterfly\" data-knit-design=\"0\" data-variants=\"[{&quot;name&quot;:&quot;Blue&quot;,&quot;front&quot;:&quot;butterfly-blue-front&quot;,&quot;back&quot;:&quot;butterfly-blue-back&quot;},{&quot;name&quot;:&quot;Pink&quot;,&quot;front&quot;:&quot;butterfly-pink-front&quot;,&quot;back&quot;:&quot;butterfly-pink-back&quot;},{&quot;name&quot;:&quot;Black&quot;,&quot;front&quot;:&quot;butterfly-black-front&quot;,&quot;back&quot;:&quot;butterfly-black-back&quot;},{&quot;name&quot;:&quot;Charcoal&quot;,&quot;front&quot;:&quot;butterfly-charcoal-front&quot;,&quot;back&quot;:&quot;butterfly-charcoal-back&quot;},{&quot;name&quot;:&quot;Burgundy&quot;,&quot;front&quot;:&quot;butterfly-burgundy-front&quot;,&quot;back&quot;:&quot;butterfly-burgundy-back&quot;}]\" inert><div class=\"product-art\"><div class=\"knit-art\" role=\"img\" aria-label=\"Butterfly Knitwear — Blue — front and back\" aria-busy=\"true\"><\/div><\/div><div class=\"caption\"><h2>Butterfly Knitwear<\/h2><p>Front &amp; back<\/p><\/div><\/section><section class=\"slide\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"14 of 14\" aria-hidden=\"true\" data-name=\"Signature Knitwear\" data-source=\"knit-signature\" data-knit-design=\"1\" data-variants=\"[{&quot;name&quot;:&quot;Blue&quot;,&quot;front&quot;:&quot;signature-blue-front&quot;,&quot;back&quot;:&quot;signature-blue-back&quot;},{&quot;name&quot;:&quot;Pink&quot;,&quot;front&quot;:&quot;signature-pink-front&quot;,&quot;back&quot;:&quot;signature-pink-back&quot;},{&quot;name&quot;:&quot;Black&quot;,&quot;front&quot;:&quot;signature-black-front&quot;,&quot;back&quot;:&quot;signature-black-back&quot;},{&quot;name&quot;:&quot;Charcoal&quot;,&quot;front&quot;:&quot;signature-charcoal-front&quot;,&quot;back&quot;:&quot;signature-charcoal-back&quot;},{&quot;name&quot;:&quot;Burgundy&quot;,&quot;front&quot;:&quot;signature-burgundy-front&quot;,&quot;back&quot;:&quot;signature-burgundy-back&quot;}]\" inert><div class=\"product-art\"><div class=\"knit-art\" role=\"img\" aria-label=\"Signature Knitwear — Blue — front and back\" aria-busy=\"true\"><\/div><\/div><div class=\"caption\"><h2>Signature Knitwear<\/h2><p>Front &amp; back<\/p><\/div><\/section><\/div><button class=\"side prev\" id=\"previous\" aria-label=\"Previous product\" aria-controls=\"slides\"><\/button><button class=\"side next\" id=\"next\" aria-label=\"Next product\" aria-controls=\"slides\"><\/button><\/div>\n<div class=\"knit-controls\" id=\"knit-controls\" hidden><div class=\"knit-designs\" role=\"group\" aria-label=\"Knitwear design\"><button type=\"button\" data-design-choice=\"0\" aria-pressed=\"true\">Butterfly<\/button><button type=\"button\" data-design-choice=\"1\" aria-pressed=\"false\">Signature<\/button><\/div><div class=\"knit-colors\" role=\"group\" aria-label=\"Colour\"><button type=\"button\" class=\"knit-swatch\" data-color-choice=\"0\" style=\"--swatch:#245068\" aria-label=\"Blue\" title=\"Blue\" aria-pressed=\"true\"><span aria-hidden=\"true\"><\/span><\/button><button type=\"button\" class=\"knit-swatch\" data-color-choice=\"1\" style=\"--swatch:#c57482\" aria-label=\"Pink\" title=\"Pink\" aria-pressed=\"false\"><span aria-hidden=\"true\"><\/span><\/button><button type=\"button\" class=\"knit-swatch\" data-color-choice=\"2\" style=\"--swatch:#191919\" aria-label=\"Black\" title=\"Black\" aria-pressed=\"false\"><span aria-hidden=\"true\"><\/span><\/button><button type=\"button\" class=\"knit-swatch\" data-color-choice=\"3\" style=\"--swatch:#555553\" aria-label=\"Charcoal\" title=\"Charcoal\" aria-pressed=\"false\"><span aria-hidden=\"true\"><\/span><\/button><button type=\"button\" class=\"knit-swatch\" data-color-choice=\"4\" style=\"--swatch:#7b1421\" aria-label=\"Burgundy\" title=\"Burgundy\" aria-pressed=\"false\"><span aria-hidden=\"true\"><\/span><\/button><\/div><span id=\"knit-color-name\" class=\"knit-color-name\">Blue<\/span><\/div><footer class=\"product-counter\" id=\"counter\" aria-label=\"Product 1 of 11\"><strong id=\"current\">01<\/strong><span class=\"slash\" aria-hidden=\"true\">/<\/span><span id=\"total\">11<\/span><\/footer>\n<canvas class=\"butterflies\" id=\"butterflies\" aria-hidden=\"true\"><\/canvas><p class=\"sr-only\" id=\"announcement\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"><\/p>\n<\/main>\n<noscript><style>.intro{display:none}.gallery{display:none}<\/style><p style=\"padding:40px;text-align:center\">Please enable JavaScript to view the Reverie collection.<\/p><\/noscript>\n<script>'use strict';\ndocument.body.classList.add('intro-pending');\nconst $=id=>document.getElementById(id);\nconst reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');\nconst slides=Array.from(document.querySelectorAll('.slide'));\nlet current=0,busy=false,introDone=false,frameId=0,finishTransition=null,introTimer=0,introFailSafe=0;\nconst introAnimations=[];\nconst clamp=v=>Math.max(0,Math.min(1,v));\nconst smooth=v=>{const t=clamp(v);return t*t*(3-2*t);};\nconst easeOut=v=>1-Math.pow(1-clamp(v),3);\nfunction updateCounter(){const number=String(current+1).padStart(2,'0');$('current').textContent=number;$('total').textContent=String(slides.length).padStart(2,'0');$('counter').setAttribute('aria-label','Product '+(current+1)+' of '+slides.length);}\nfunction show(index){slides[current].classList.remove('active');slides[current].setAttribute('aria-hidden','true');slides[current].inert=true;current=index;slides[current].classList.add('active');slides[current].setAttribute('aria-hidden','false');slides[current].inert=false;updateCounter();$('announcement').textContent=slides[current].dataset.name+', product '+(current+1)+' of '+slides.length;}\nupdateCounter();\nif(slides.length<2){$('previous').hidden=true;$('next').hidden=true;}\n// Intro: logo alone -> logo travels to the header -> the complete gallery appears.\nfunction finishIntro(){\n if(introDone)return;introDone=true;clearTimeout(introTimer);clearTimeout(introFailSafe);\n introAnimations.forEach(animation=>animation.cancel());\n const hadFocus=$('intro').contains(document.activeElement);\n document.body.classList.remove('intro-pending','revealing');$('intro').hidden=true;$('gallery').inert=false;$('gallery').removeAttribute('aria-hidden');\n if(hadFocus)$('next').focus({preventScroll:true});\n}\nasync function openGallery(){\n if(introDone)return;if(reducedMotion.matches||!$('intro-logo').animate){finishIntro();return;}\n const source=$('intro-logo').getBoundingClientRect(),target=$('header-logo').getBoundingClientRect();\n const dx=target.left+target.width/2-source.left-source.width/2,dy=target.top+target.height/2-source.top-source.height/2;\n // The header and intro use matching aspect ratios, preserving the logo silhouette.\n const scale=target.width/source.width;\n document.body.classList.add('revealing');\n const flight=$('intro-logo').animate([\n  {transform:'translate(-50%,-50%) translate(0px,0px) scale(1)',opacity:1},\n  {transform:'translate(-50%,-50%) translate('+dx+'px,'+dy+'px) scale('+scale+')',opacity:1}\n ],{duration:1150,easing:'cubic-bezier(.65,0,.18,1)',fill:'forwards'});\n const veil=$('intro-veil').animate([{opacity:1},{opacity:0}],{duration:1000,delay:180,easing:'ease',fill:'forwards'});\n introAnimations.push(flight,veil);\n try{await Promise.all([flight.finished,veil.finished]);}catch(_){}finally{finishIntro();}\n}\n$('intro').addEventListener('click',finishIntro);\n$('intro').addEventListener('keydown',event=>{if(['Escape','Enter',' '].includes(event.key)){event.preventDefault();finishIntro();}});\nif(reducedMotion.matches)finishIntro();else{introTimer=setTimeout(openGallery,850);introFailSafe=setTimeout(finishIntro,5000);}\nconst canvas=$('butterflies'),context=canvas.getContext('2d');let width=0,height=0;\nfunction resize(){const rect=canvas.getBoundingClientRect();width=rect.width;height=rect.height;const ratio=Math.min(window.devicePixelRatio||1,2);canvas.width=Math.max(1,Math.round(width*ratio));canvas.height=Math.max(1,Math.round(height*ratio));if(context)context.setTransform(ratio,0,0,ratio,0,0);}\nresize();window.addEventListener('resize',()=>{resize();if(document.body.classList.contains('revealing'))finishIntro();});\nconst forewing=new Path2D('M0 1 C-7 -7 -16 -27 -26 -25 C-38 -23 -31 -11 -30 -7 C-32 -1 -22 4 -16 5 C-8 7 -3 4 0 1Z');\nconst hindwing=new Path2D('M0 2 C-7 4 -20 0 -24 9 C-28 16 -22 24 -16 20 C-11 24 -5 17 -3 10Z');\nfunction butterfly(x,y,size,angle,phase,opacity){context.save();context.translate(x,y);context.rotate(angle);context.scale(size,size);context.globalAlpha=opacity;context.fillStyle='#080808';for(const sign of [-1,1]){context.save();context.scale(sign*(.16+.84*Math.abs(Math.sin(phase))),1);context.fill(forewing);context.fill(hindwing);context.restore();}context.beginPath();context.ellipse(0,0,1.5,9,0,0,Math.PI*2);context.fill();context.strokeStyle='#080808';context.lineWidth=.6;context.beginPath();context.moveTo(0,-8);context.quadraticCurveTo(-2,-14,-5,-16);context.moveTo(0,-8);context.quadraticCurveTo(2,-14,5,-16);context.stroke();context.restore();}\nfunction navigate(target,direction=1){\n if(!introDone||busy||slides.length<2)return;target=(target+slides.length)%slides.length;if(target===current)return;\n if(reducedMotion.matches){show(target);return;}\n busy=true;[$('previous'),$('next')].forEach(el=>el.setAttribute('aria-disabled','true'));\n const outgoing=slides[current],incoming=slides[target];outgoing.classList.add('transitioning');incoming.classList.add('transitioning');incoming.style.opacity='0';\n const flock=Array.from({length:width<640?36:62},(_,i)=>({delay:(i%3)*.06+Math.random()*.09,duration:.54+Math.random()*.14,y:height*(.18+Math.random()*.65),size:.25+Math.random()*.83,phase:Math.random()*Math.PI*2,wave:15+Math.random()*45,speed:.015+Math.random()*.012}));\n let start=null,changed=false;\n const finish=()=>{cancelAnimationFrame(frameId);if(!changed){show(target);changed=true;}if(context)context.clearRect(0,0,width,height);[outgoing,incoming].forEach(slide=>{slide.classList.remove('transitioning');['opacity','transform','filter'].forEach(property=>slide.style.removeProperty(property));});busy=false;finishTransition=null;[$('previous'),$('next')].forEach(el=>el.setAttribute('aria-disabled','false'));};\n finishTransition=finish;\n function frame(now){\n  if(start===null)start=now;const elapsed=now-start,p=elapsed/1450;\n  if(context)context.clearRect(0,0,width,height);\n  const exit=smooth((p-.02)/.48),enter=easeOut((p-.28)/.66);\n  outgoing.style.opacity=String(1-exit);outgoing.style.transform='translate3d('+(-direction*width*.10*exit)+'px,0,0) scale('+(1-.06*exit)+')';outgoing.style.filter='blur('+(exit*4)+'px)';\n  incoming.style.opacity=String(smooth((p-.28)/.43));incoming.style.transform='translate3d('+(direction*width*.10*(1-enter))+'px,0,0) scale('+(1+.04*(1-enter))+')';incoming.style.filter='blur('+((1-enter)*4)+'px)';\n  if(p>.45&&!changed){show(target);changed=true;}\n  if(context)flock.forEach(b=>{const t=(p-b.delay)/b.duration;if(t<0||t>1)return;const x=direction>0?width+80-t*(width+160):-80+t*(width+160);const y=b.y+Math.sin(t*5+b.phase)*b.wave-Math.sin(t*Math.PI)*height*.08;butterfly(x,y,b.size,(direction>0?-1:1)*Math.PI/2+Math.cos(t*5+b.phase)*.35,elapsed*b.speed+b.phase,Math.min(1,t*9,(1-t)*8));});\n  if(p<1.04)frameId=requestAnimationFrame(frame);else finish();\n }\n frameId=requestAnimationFrame(frame);\n}\nlet suppressClickUntil=0;\nfunction sideClick(step,event){if(event.detail!==0&&Date.now()<suppressClickUntil)return;navigate(current+step,step);}\n$('previous').addEventListener('click',event=>sideClick(-1,event));$('next').addEventListener('click',event=>sideClick(1,event));\ndocument.addEventListener('keydown',event=>{if(event.altKey||event.ctrlKey||event.metaKey||event.shiftKey)return;if(!introDone){if(event.key==='Escape')finishIntro();return;}if(event.key==='ArrowRight'){event.preventDefault();navigate(current+1,1);}else if(event.key==='ArrowLeft'){event.preventDefault();navigate(current-1,-1);}else if(event.key==='Home'){event.preventDefault();navigate(0,-1);}else if(event.key==='End'){event.preventDefault();navigate(slides.length-1,1);}});\nlet touch=null;\n$('stage').addEventListener('touchstart',event=>{touch=event.touches.length===1?{x:event.touches[0].clientX,y:event.touches[0].clientY}:null;},{passive:true});\n$('stage').addEventListener('touchend',event=>{if(!touch)return;const dx=event.changedTouches[0].clientX-touch.x,dy=event.changedTouches[0].clientY-touch.y;touch=null;if(Math.abs(dx)>45&&Math.abs(dx)>Math.abs(dy)*1.4){suppressClickUntil=Date.now()+700;navigate(current+(dx<0?1:-1),dx<0?1:-1);}},{passive:true});\n$('stage').addEventListener('touchcancel',()=>{touch=null;},{passive:true});\ndocument.addEventListener('visibilitychange',()=>{if(document.hidden){finishIntro();if(finishTransition)finishTransition();}});\nreducedMotion.addEventListener('change',()=>{if(reducedMotion.matches){finishIntro();if(finishTransition)finishTransition();}});\n<\/script>\n<!--KNITWEAR_ASSETS--><script data-knitwear-controls>(()=>{\n 'use strict';\n const items=Array.from(document.querySelectorAll('.slide[data-knit-design]'));\n if(!items.length)return;\n const assets=JSON.parse(document.getElementById('knitwear-image-data').textContent);\n const controls=document.getElementById('knit-controls'),next=document.getElementById('next'),announcement=document.getElementById('announcement');\n const colors=['Blue','Pink','Black','Charcoal','Burgundy'];\n const media=matchMedia('(prefers-reduced-motion: reduce)'),NS='http://www.w3.org/2000/svg';\n const decoded=new Map(),animations=new Set();\n const states=items.map(item=>({item,art:item.querySelector('.knit-art'),variants:JSON.parse(item.dataset.variants),chosen:0,displayed:-1,layer:null,running:false}));\n let selectedColor=0;\n const designButtons=Array.from(controls.querySelectorAll('[data-design-choice]'));\n const swatches=Array.from(controls.querySelectorAll('[data-color-choice]'));\n const active=()=>states.find(state=>state.item.classList.contains('active'))||states[0];\n const locked=()=>next.getAttribute('aria-disabled')==='true';\n function renderControls(){\n  const state=active(),busy=locked();\n  designButtons.forEach((button,i)=>{button.setAttribute('aria-pressed',String(states[i]===state));button.disabled=busy});\n  swatches.forEach((button,i)=>{button.setAttribute('aria-pressed',String(i===selectedColor));button.disabled=busy});\n  document.getElementById('knit-color-name').textContent=colors[selectedColor];\n }\n function svg(tag,attrs){const node=document.createElementNS(NS,tag);for(const [key,value]of Object.entries(attrs))node.setAttribute(key,String(value));return node}\n function makeLayer(state,index){\n  const variant=state.variants[index],layer=document.createElement('div');\n  layer.className='knit-colour-layer';layer.dataset.color=variant.name;layer.setAttribute('aria-hidden','true');\n  const frame=svg('svg',{viewBox:'0 0 2500 1040',preserveAspectRatio:'xMidYMid meet',focusable:'false'});\n  [variant.front,variant.back].forEach((key,side)=>{\n   const asset=assets[key],bounds=asset.bounds,crop=asset.crop;\n   // Identical neckline height, hem baseline and side centres for every colour.\n   const scale=820/bounds[3],center=side===0?625:1875;\n   const x=center+(crop[0]-bounds[0]-bounds[2]/2)*scale,y=110+(crop[1]-bounds[1])*scale;\n   const viewport=svg('svg',{x,y,width:crop[2]*scale,height:crop[3]*scale,style:'width:'+crop[2]*scale+'px;height:'+crop[3]*scale+'px',viewBox:crop.join(' '),overflow:'hidden','data-side':side===0?'front':'back','data-asset':key});\n   viewport.append(svg('image',{href:asset.src,width:asset.width,height:asset.height,preserveAspectRatio:'none'}));frame.append(viewport);\n  });\n  layer.append(frame);return layer;\n }\n function decode(key){\n  if(!decoded.has(key)){\n   const pending=new Promise((resolve,reject)=>{\n    const image=new Image();image.decoding='async';\n    const canDecode=typeof image.decode==='function';\n    image.onload=()=>{if(!canDecode)resolve(image)};image.onerror=()=>reject(new Error('Could not load '+key));image.src=assets[key].src;\n    if(canDecode)image.decode().then(()=>resolve(image),reject);\n    else if(image.complete&&image.naturalWidth)resolve(image);\n   }).catch(error=>{decoded.delete(key);throw error});\n   decoded.set(key,pending);\n  }\n  return decoded.get(key);\n }\n function prepare(state,index){const variant=state.variants[index];return Promise.all([decode(variant.front),decode(variant.back)])}\n async function crossfade(layer){\n  if(media.matches||document.hidden)return;\n  if(typeof layer.animate==='function'){\n   const animation=layer.animate([{opacity:0},{opacity:1}],{duration:560,easing:'cubic-bezier(.4,0,.2,1)',fill:'both'});\n   animations.add(animation);\n   try{await animation.finished}catch(_){}finally{layer.style.opacity='1';animations.delete(animation);animation.cancel()}\n  }else{\n   // The fallback preserves the outgoing layer until the incoming one is opaque.\n   await new Promise(resolve=>{\n    let start=null,raf=0,timer=0;\n    const finish=()=>{cancelAnimationFrame(raf);clearTimeout(timer);media.removeEventListener('change',onChange);document.removeEventListener('visibilitychange',onChange);layer.style.opacity='1';resolve()};\n    const onChange=()=>{if(media.matches||document.hidden)finish()};\n    const frame=time=>{start??=time;const p=Math.min(1,(time-start)/560);layer.style.opacity=String(p*p*(3-2*p));if(p<1)raf=requestAnimationFrame(frame);else finish()};\n    layer.style.opacity='0';media.addEventListener('change',onChange);document.addEventListener('visibilitychange',onChange);raf=requestAnimationFrame(frame);timer=setTimeout(finish,1000);\n   });\n  }\n }\n function settle(state){\n  if(state.running)return state.task;\n  state.running=true;state.art.setAttribute('aria-busy','true');\n  state.task=(async()=>{\n  try{\n   while(state.displayed!==state.chosen){\n    const index=state.chosen;\n    await prepare(state,index);\n    // A newer swatch click supersedes a colour still decoding.\n    if(index!==state.chosen)continue;\n    const incoming=makeLayer(state,index),outgoing=state.layer;\n    state.art.append(incoming);\n    if(outgoing&&state===active())await crossfade(incoming);\n    // During a crossfade, keep both views tied to this article only.\n    outgoing?.remove();state.layer=incoming;state.displayed=index;\n    state.art.dataset.color=colors[index];\n    state.art.setAttribute('aria-label',state.item.dataset.name+' — '+colors[index]+' — front and back');\n   }\n  }catch(_){\n   if(state===active())announcement.textContent='This view could not load. Please choose the colour again.';\n  }finally{state.running=false;state.art.setAttribute('aria-busy','false');renderControls()}\n  })();\n  return state.task;\n }\n function chooseColor(index){\n  if(locked()||index<0||index>=colors.length)return;\n  const state=active();if(selectedColor===index&&states.every(item=>item.displayed===index))return;\n  selectedColor=index;\n  // One catalogue colour: prepare both designs together, crossfade only the visible one.\n  states.forEach(item=>{item.chosen=index;settle(item)});renderControls();\n  announcement.textContent=state.item.dataset.name+', '+colors[index].toLowerCase()+', front and back';\n }\n // All article navigation (buttons, screen sides, keys and swipes) keeps this colour.\n // If the target images are still decoding, wait before starting its butterfly flight.\n const navigateArticle=navigate;\n navigate=function(target,direction=1){\n  if(locked())return;\n  target=(target%states.length+states.length)%states.length;\n  const destination=states[target];\n  if(destination===active())return;\n  if(destination.displayed===selectedColor&&!destination.running){navigateArticle(target,direction);return}\n  const sides=[document.getElementById('previous'),next];\n  sides.forEach(button=>button.setAttribute('aria-disabled','true'));renderControls();\n  destination.chosen=selectedColor;\n  settle(destination).then(()=>{\n   sides.forEach(button=>button.setAttribute('aria-disabled','false'));\n   if(destination.displayed===selectedColor)navigateArticle(target,direction);\n   else announcement.textContent='This view could not load. Please try again.';\n   renderControls();\n  });\n };\n swatches.forEach((button,i)=>button.addEventListener('click',()=>chooseColor(i)));\n designButtons.forEach((button,i)=>button.addEventListener('click',()=>{if(locked())return;const index=states.indexOf(active());if(index!==i)navigate(i,i>index?1:-1)}));\n controls.addEventListener('keydown',event=>{\n  if(event.altKey||event.ctrlKey||event.metaKey||event.shiftKey)return;\n  const colorButton=event.target.closest('[data-color-choice]');\n  if(colorButton&&['ArrowLeft','ArrowRight','Home','End'].includes(event.key)){\n   event.preventDefault();event.stopPropagation();if(locked())return;\n   const current=Number(colorButton.dataset.colorChoice),index=event.key==='Home'?0:event.key==='End'?colors.length-1:(current+(event.key==='ArrowRight'?1:-1)+colors.length)%colors.length;\n   chooseColor(index);swatches[index].focus();\n  }else if(event.target.closest('[data-design-choice]')&&['ArrowLeft','ArrowRight','Home','End'].includes(event.key)){\n   event.preventDefault();event.stopPropagation();if(locked())return;\n   const index=event.key==='Home'||event.key==='ArrowLeft'?0:1;designButtons[index].click();\n  }\n });\n new MutationObserver(renderControls).observe(document.getElementById('slides'),{attributes:true,subtree:true,attributeFilter:['class']});\n new MutationObserver(renderControls).observe(next,{attributes:true,attributeFilter:['aria-disabled']});\n const finishAnimations=()=>{if(media.matches||document.hidden)for(const animation of animations){try{animation.finish()}catch(_){animation.cancel()}}};\n media.addEventListener('change',finishAnimations);document.addEventListener('visibilitychange',finishAnimations);\n document.body.classList.add('knit-collection');controls.hidden=false;\n states.forEach(state=>{state.layer=makeLayer(state,0);state.art.append(state.layer);state.displayed=0;state.art.dataset.color=colors[0];state.art.setAttribute('aria-busy','false')});\n renderControls();\n // Warm images sequentially in idle time, keeping the intro and UI responsive.\n const queue=states.flatMap(state=>state.variants.flatMap(variant=>[variant.front,variant.back]));\n const idle=callback=>window.requestIdleCallback?requestIdleCallback(callback,{timeout:1500}):setTimeout(callback,120);\n const warm=()=>{const key=queue.shift();if(!key)return;decode(key).catch(()=>{}).finally(()=>{if(queue.length)idle(warm)})};idle(warm);\n})();\n<\/script><\/body><\/html>"